<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Núcleo do Téra Tools: algoritmos e modelos puros, sem dependência do Revit.
    Tudo aqui pode ser testado automaticamente (inclusive fora do Windows).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TeraTools.Core</RootNamespace>
    <AssemblyName>TeraTools.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeraTools.Core.Tests" />
  </ItemGroup>

</Project>
